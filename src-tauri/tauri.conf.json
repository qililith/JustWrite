{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "写文章",
  "mainBinaryName": "justwrite",
  "version": "../package.json",
  "identifier": "app.justwrite.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "写文章",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "backgroundColor": "#ffffff",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "qililith",
    "shortDescription": "写文章",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5QjYzNjg1MjlFRjEwOEIKUldTTEVPOHBoVGEycVR6ako2Wlo0RFdFRjV0bHBlYlU2V1VpSGlNR0J5aE1iQVRBUXBxRUxvK2MK",
      "endpoints": ["https://changwen-updates.pages.dev/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
